# Database Configuration
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority

# Server Configuration
PORT=3000
BASE_URL=/api/v1
NODE_ENV=development

# JWT Secrets (REQUIRED - generate strong random strings)
PRV_TOKEN=your-private-token-secret-here
RESET_TOKEN_SECRET=your-reset-token-secret-here-min-32-characters
ACCESS_TOKEN_SECRET=your-access-token-secret-here-min-32-characters

# Email Configuration for OTP
# For Gmail: Use App Password (not regular password)
# Enable 2FA on Gmail, then generate App Password at: https://myaccount.google.com/apppasswords
EMAIL_SERVICE=gmail
OTP_EMAIL=your-otp-email@example.com
OTP_PASSWORD=your-gmail-app-password-here
EMAIL_FROM=your-otp-email@example.com

# Alternative Email Variables (if using different naming)
EMAIL_USER=your-otp-email@example.com
EMAIL_PASSWORD=your-gmail-app-password-here

# Admin Configuration
ADMIN_EMAIL=admin@example.com

# Image and Client URLs
IMAGE_URL=http://localhost:3000/
CLIENT_URL=http://localhost:5173

# OTP Service Secret
OTP_SECRET=your-otp-secret-key-here

STRIPE_WEBHOOK_KEY=your-stripe-webhook-secret-here
STRIPE_SECRET_KEY=your-stripe-secret-key-here

# Custom SMTP (if not using gmail)
# EMAIL_SERVICE=custom
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_SECURE=false

